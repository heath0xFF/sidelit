{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidelit",
  "version": "0.3.0",
  "identifier": "app.sidelit.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Sidelit",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src sidelit-preview: http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:* http://[::1]:* https://[::1]:*; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNjE3RjY1QTQ3OTQxRTAKUldUZ1FYbWtaWDloekUxMkFIZlhXQzhubEIyaC82SVdscUUvaWZ5Zk5ueHBkcHhScVByQ1F3ZE4K",
      "endpoints": ["https://github.com/heath0xFF/sidelit/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Visual previews and feedback beside your terminal.",
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["mdx"],
        "name": "MDX document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML document",
        "role": "Editor",
        "mimeType": "text/html"
      }
    ]
  }
}
